# ========== 根目录 ==========
/*
!/.gitignore
!/package.json
!/README.md
!/todo.db
!/src/
!/Document/
!/model/
!/run.bat
!/tools/

# ========== model 层：先忽略 model 下所有，再放行想要的 ==========
/model/*
!/model/authority.yaml
!/model/Log_Review-tag-0.0.1+python/
!/model/Model-Annotation-tag-0.1.1+python/
!/model/Offline_Package_Organization-tag-0.0.12+python/
!/model/trueno3_src-master-0.0.10/
!/model/Weekly-Report-Print-tag-0.0.8+python/
!/model/Project_Closing_PPT-tag0.0.1+python/

# ========== Log_Review 层 ==========
/model/Log_Review-tag-0.0.1+python/*
!/model/Log_Review-tag-0.0.1+python/txt_log_to_xlsx.py
!/model/Log_Review-tag-0.0.1+python/identification/

# identification 层
/model/Log_Review-tag-0.0.1+python/identification/*
!/model/Log_Review-tag-0.0.1+python/identification/plot_meter_image.py

# ========== Model-Annotation 层 ==========
/model/Model-Annotation-tag-0.1.1+python/*
!/model/Model-Annotation-tag-0.1.1+python/src/

# src 层：只保留直接子级的 .py
/model/Model-Annotation-tag-0.1.1+python/src/*
!/model/Model-Annotation-tag-0.1.1+python/src/*.py

# ========== Offline_Package_Organization 层 ==========
/model/Offline_Package_Organization-tag-0.0.12+python/*
!/model/Offline_Package_Organization-tag-0.0.12+python/*.py

# ========== trueno3 层 ==========
/model/trueno3_src-master-0.0.10/*
!/model/trueno3_src-master-0.0.10/local_inference/

# local_inference 层：只保留直接子级的 .py
/model/trueno3_src-master-0.0.10/local_inference/*
!/model/trueno3_src-master-0.0.10/local_inference/*.py

# ========== Weekly-Report 层 ==========
/model/Weekly-Report-Print-tag-0.0.8+python/*
!/model/Weekly-Report-Print-tag-0.0.8+python/*.py

# ========== Project_Closing_PPT 层 ==========
# 先忽略整个模型目录
/model/Project_Closing_PPT-tag0.0.1+python/*
# 代码入口与运行脚本
!/model/Project_Closing_PPT-tag0.0.1+python/portal_entry.py
!/model/Project_Closing_PPT-tag0.0.1+python/gen_ppt.bat
# 配置、依赖说明、README
!/model/Project_Closing_PPT-tag0.0.1+python/config.yaml
!/model/Project_Closing_PPT-tag0.0.1+python/requirements.txt
!/model/Project_Closing_PPT-tag0.0.1+python/README.md
# PPT 模板（运行时必需）
!/model/Project_Closing_PPT-tag0.0.1+python/model-aiglrithm.pptx
# 源码目录
!/model/Project_Closing_PPT-tag0.0.1+python/src/

# src 层：只保留直接子级的 .py
/model/Project_Closing_PPT-tag0.0.1+python/src/*
!/model/Project_Closing_PPT-tag0.0.1+python/src/*.py

# 运行时产出与临时文件（显式再排除一次，防止被上面的放行规则带回）
/model/Project_Closing_PPT-tag0.0.1+python/portal_inputs/
/model/Project_Closing_PPT-tag0.0.1+python/portal_outputs/
/model/Project_Closing_PPT-tag0.0.1+python/.portal_tmp/
/model/Project_Closing_PPT-tag0.0.1+python/images/
/model/Project_Closing_PPT-tag0.0.1+python/*_算法结项_*.pptx

# ========== 通用忽略：缓存与虚拟环境 ==========
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
ENV/
.runtime-cache/
.portal_tmp/
.portal_recycle/